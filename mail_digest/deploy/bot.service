[Unit]
Description=Telegram assistant bot (answers only the owner)
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=pi
WorkingDirectory=/home/pi/mail_digest
ExecStart=/usr/bin/python3 -u /home/pi/mail_digest/bot.py
# Restart automatically 30 seconds after an error exit.
Restart=always
RestartSec=30

[Install]
WantedBy=multi-user.target
