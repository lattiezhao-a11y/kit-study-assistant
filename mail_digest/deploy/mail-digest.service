# Raspberry Pi “task definition”: run the mail-digest script once.
# Installation path: /etc/systemd/system/mail-digest.service
# Replace User and paths with the actual deployment user during setup.
[Unit]
Description=Mail digest + ILIAS deadline sync (push to Telegram)
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=pi
WorkingDirectory=/home/pi/mail_digest
# Process email first, then ILIAS. The leading - means one can fail without preventing the other from running.
ExecStart=-/usr/bin/python3 /home/pi/mail_digest/digest.py
ExecStart=-/usr/bin/python3 /home/pi/mail_digest/ilias_sync.py
