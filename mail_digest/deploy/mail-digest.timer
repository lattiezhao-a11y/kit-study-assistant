# 树莓派上的"闹钟"：每 6 小时触发一次 mail-digest.service。
# 安装位置：/etc/systemd/system/mail-digest.timer
# 启用：sudo systemctl enable --now mail-digest.timer
[Unit]
Description=Run mail digest every 6 hours

[Timer]
# 每天 01:30 / 07:30 / 13:30 / 19:30（树莓派本地时间）
OnCalendar=*-*-* 01,07,13,19:30:00
# 到点时树莓派正好关机的话，开机后补跑一次
Persistent=true

[Install]
WantedBy=timers.target
