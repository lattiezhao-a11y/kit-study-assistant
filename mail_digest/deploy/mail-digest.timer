# Raspberry Pi “alarm clock”: trigger mail-digest.service every six hours.
# Installation path: /etc/systemd/system/mail-digest.timer
# Enable with: sudo systemctl enable --now mail-digest.timer
[Unit]
Description=Run mail digest every 6 hours

[Timer]
# Every day at 01:30, 07:30, 13:30, and 19:30 (Raspberry Pi local time).
OnCalendar=*-*-* 01,07,13,19:30:00
# Run once after boot if the Raspberry Pi was powered off at the scheduled time.
Persistent=true

[Install]
WantedBy=timers.target
